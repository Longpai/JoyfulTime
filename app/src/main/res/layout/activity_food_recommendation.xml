<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    tools:context=".FoodRecommendationActivity">

    <!-- Left side container: 1/3 width -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Back to Main -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#F8BBD0">

            <View
                android:id="@+id/view_back_to_main"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="返回"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Home Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#FFCDD2">

            <View
                android:id="@+id/view_section_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="首页"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Rest Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#C8E6C9">

            <View
                android:id="@+id/view_section_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="休息"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Food Button (Current) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#BBDEFB">

            <View
                android:id="@+id/view_section_3"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="美食"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@android:color/white" />
        </RelativeLayout>

    </LinearLayout>

    <!-- Right side content area: 2/3 width -->
    <LinearLayout
        android:id="@+id/right_content"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="4"
        android:orientation="vertical"
        android:background="#FFFFFF">

        <!-- 标题 -->
        <TextView
            android:id="@+id/title_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="美食推荐"
            android:textSize="20sp"
            android:textStyle="bold"
            android:padding="16dp" />

        <!-- 搜索区域 -->
        <LinearLayout
            android:id="@+id/search_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <EditText
                android:id="@+id/city_edit_text"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="输入城市名称（如：北京、上海）"
                android:inputType="text"
                android:padding="8dp"
                android:background="@android:drawable/edit_text"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/keywords_edit_text"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="输入搜索关键词（如：火锅、川菜）"
                android:inputType="text"
                android:padding="8dp"
                android:background="@android:drawable/edit_text"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/search_button"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="搜索美食"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 加载进度条 -->
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- 美食列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/food_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <!-- 空状态提示 -->
        <TextView
            android:id="@+id/empty_text_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="16sp"
            android:textColor="#999999"
            android:text="没有找到美食推荐，请输入城市进行搜索" />

    </LinearLayout>

</LinearLayout>
